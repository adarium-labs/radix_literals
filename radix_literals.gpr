with "config/radix_literals_config.gpr";
project Radix_Literals is

   for Library_Name use "Radix_Literals";
   for Library_Version use Project'Library_Name & ".so." & Radix_Literals_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/", "prove/");
   for Object_Dir use "obj/" & Radix_Literals_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("RADIX_LITERALS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Radix_Literals_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Radix_Literals;
